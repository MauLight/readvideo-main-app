# All optional — the service boots with none of these set.
# API keys are deliberately absent: they arrive per request as headers.

# Port to listen on.
PORT=4000

# Chat model used for generation.
OPENAI_MODEL=gpt-4o-mini

# Language the article is written in, whatever language the video is in.
ARTICLE_LANGUAGE=English

# Caption track to request first; falls back to whatever YouTube defaults to.
TRANSCRIPT_LANG=en
