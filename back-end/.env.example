# Server port (front-end Next.js already uses 3000)
PORT=4000

# Optional: override the model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# API keys are NOT configured here any more — they belong to the user and
# arrive per request:
#   x-openai-key    required on every endpoint
#   x-youtube-key   required for playlists only
# Under Electron they come from the OS keychain via safeStorage instead.
